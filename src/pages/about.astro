---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
---

<BaseLayout>
  <head>
    <SEO
      title="About Us - WhatsDiscount UK"
      description="Learn about WhatsDiscount, the UK's trusted voucher code and promo code aggregator. We help you save money with hand-tested codes from thousands of stores."
    />
  </head>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">About WhatsDiscount</h1>
    
    <div class="prose prose-gray max-w-none">
      <p class="text-gray-600 mb-4">
        WhatsDiscount is a UK-based voucher code and promo code aggregation platform. Our mission is to help consumers save money by providing verified, hand-tested discount codes from thousands of retailers across the United Kingdom.
      </p>
      
      <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-4">What We Do</h2>
      <p class="text-gray-600 mb-4">
        We collect and verify promo codes from over 3,000 UK stores, covering categories including fashion, electronics, home & garden, travel, food & drink, and many more. Our team works to ensure the codes we list are active and working, so you can shop with confidence.
      </p>
      
      <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-4">How It Works</h2>
      <ol class="list-decimal list-inside space-y-2 text-gray-600 mb-4">
        <li>Browse stores by category or search for your favourite retailer</li>
        <li>Find a voucher code or deal that suits your needs</li>
        <li>Click "Show Code" to reveal the discount code</li>
        <li>Copy the code and visit the store's website</li>
        <li>Apply the code at checkout to save money</li>
      </ol>
      
      <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-4">Why Trust Us</h2>
      <ul class="list-disc list-inside space-y-2 text-gray-600 mb-4">
        <li>All codes are regularly verified for validity</li>
        <li>We display the last updated date for transparency</li>
        <li>Our saving tips help you maximise your savings</li>
        <li>We cover a wide range of UK retailers</li>
      </ul>
      
      <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-4">Get in Touch</h2>
      <p class="text-gray-600 mb-4">
        Have a question, suggestion, or found a code that isn't working? <a href="/contact" class="text-primary hover:text-primary-hover">Contact us</a> and we'll get back to you as soon as possible.
      </p>
    </div>
  </div>
</BaseLayout>
