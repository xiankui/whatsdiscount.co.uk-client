---
import { getStoreDetail, getRelatedStores } from '../../lib/cms-client';
import { getImageUrl, encodeCouponLink, formatDate, extractDiscountInfo } from '../../lib/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StoreCard from '../../components/StoreCard.astro';
import type { SiteStoreDetail, SiteStoreSummary } from '../../lib/types';

const { domain } = Astro.params;

if (!domain) {
  return Astro.redirect('/');
}

let store: SiteStoreDetail | null = null;
let relatedStores: SiteStoreSummary[] = [];

try {
  store = await getStoreDetail(domain);
} catch {
  return Astro.redirect('/');
}

try {
  relatedStores = await getRelatedStores(domain, 6);
} catch {
  // Empty fallback
}

const isValid = (coupon: { isValid?: number }) => coupon.isValid !== 0;
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title={store.seo.title}
      description={store.seo.description}
      keywords={store.seo.keywords}
      image={getImageUrl(store.logoPic)}
      structuredData={{
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://www.whatsdiscount.co.uk/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": store.name,
                "item": `https://www.whatsdiscount.co.uk/discount/${domain}`
              }
            ]
          },
          ...(store.faqs.length > 0 ? [{
            "@type": "FAQPage",
            "mainEntity": store.faqs.map((faq) => ({
              "@type": "Question",
              "name": faq.topic,
              "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.content
              }
            }))
          }] : [])
        ]
      }}
    />
  </Fragment>

  <div class="flex-grow pt-28 pb-16 px-4 sm:px-6 lg:px-8 max-w-container-max mx-auto w-full">
    <!-- Brand Header Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-gutter mb-12">
      <div class="lg:col-span-8 glass-panel p-8 rounded-xl flex items-center gap-6 md:gap-8">
        <div class="w-20 h-20 md:w-24 md:h-24 bg-white rounded-full flex items-center justify-center p-4 shadow-sm shrink-0">
          <img
            src={getImageUrl(store.logoPic)}
            alt={store.name}
            class="w-full h-auto object-contain"
          />
        </div>
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-2">{store.seo.h1}</h1>
          <p class="text-on-surface-variant leading-relaxed max-w-2xl">{store.about}</p>
        </div>
      </div>
      
      <!-- Brand Stats Bento Cell -->
      <div class="lg:col-span-4 glass-panel p-8 rounded-xl flex flex-col justify-between border-l-4 border-primary">
        <div class="space-y-6">
          <div class="flex justify-between items-end">
            <span class="text-on-surface-variant">Success Rate</span>
            <span class="text-2xl font-bold text-primary">{store.successRate}%</span>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-on-surface-variant">Active Vouchers</span>
            <span class="text-2xl font-bold text-primary">{store.coupons.length}</span>
          </div>
          {store.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {store.tags.map((tag) => (
                <a
                  href={`/tag-${tag.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and')}`}
                  class="tag text-xs"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Main Feed and Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <!-- Vouchers Feed -->
      <div class="lg:col-span-8 space-y-6">
        <h2 class="text-2xl font-bold text-on-surface mb-6">Latest {store.name} Vouchers</h2>
        
        {store.coupons.map((coupon) => {
          const encodedId = encodeCouponLink(store.domain, coupon.id);
          const valid = isValid(coupon);
          const discountText = coupon.disInfo || coupon.title;
          const { value: discountValue, type: discountType } = extractDiscountInfo(discountText);
          
          return (
            <div class="bg-white rounded-xl shadow-sm border border-midnight-navy/5 overflow-hidden flex flex-col md:flex-row hover:shadow-md transition-shadow group shimmer-sweep">
              <!-- Left: Discount Value -->
              <div class="p-8 md:w-48 shrink-0 flex flex-col justify-center items-center bg-surface-container-low border-r border-dashed border-outline-variant/40 relative digital-ticket text-center">
                <span class="text-3xl font-extrabold text-primary leading-tight">{discountValue}</span>
                <span class="label-caps text-on-surface-variant mt-1">{discountType}</span>
              </div>
              
              <!-- Center: Details -->
              <div class="flex-grow p-8 flex flex-col justify-between">
                <div>
                  {valid && (
                    <div class="flex items-center gap-2 mb-2">
                      <svg class="w-4 h-4 text-tertiary" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      <span class="label-caps text-tertiary">VERIFIED</span>
                    </div>
                  )}
                  <h3 class="text-xl font-bold text-on-surface">{coupon.title}</h3>
                  {coupon.description && (
                    <p class="text-on-surface-variant mt-1">{coupon.description}</p>
                  )}
                </div>
                <div class="flex items-center justify-between mt-6 group">
                  <span class="label-caps text-on-surface-variant">
                    {store.lastUpdateAt ? `UPDATED ${formatDate(store.lastUpdateAt)}` : 'ALWAYS ACTIVE'}
                  </span>
                  {coupon.type === 'code' && coupon.code ? (
                    <a
                      href={`/detail/${encodedId}`}
                      class="btn-code-reveal group-hover:scale-105 transition-transform"
                    >
                      <span class="btn-code-reveal-main">Show Code</span>
                      <span class="btn-code-reveal-peel">
                        <span class="code-reveal-extra">{coupon.code.slice(-3, -2)}</span>{coupon.code.slice(-2)}
                      </span>
                    </a>
                  ) : (
                    <a
                      href={`/api/r?domain=${store.domain}`}
                      class="btn-primary px-8 flex items-center gap-2"
                      rel="nofollow noopener"
                      target="_blank"
                    >
                      Get Deal
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Sidebar Info -->
      <aside class="lg:col-span-4 space-y-6">
        {store.savingTips.length > 0 && (
          <div class="glass-panel p-6 rounded-xl">
            <h3 class="text-xl font-bold text-on-surface mb-4">Saving Tips</h3>
            <ul class="space-y-4">
              {store.savingTips.map((tip) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <div>
                    <p class="font-semibold text-on-surface text-sm">{tip.title}</p>
                    <p class="text-on-surface-variant text-sm mt-0.5">{tip.content}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- FAQ Section -->
        {store.faqs.length > 0 && (
          <div class="glass-panel p-6 rounded-xl">
            <h3 class="text-xl font-bold text-on-surface mb-4">FAQs</h3>
            <div class="space-y-3" id="store-faq">
              {store.faqs.map((faq, index) => (
                <div>
                  <button
                    class="store-faq-toggle w-full flex justify-between items-center text-left text-sm font-bold text-on-surface group py-2"
                    aria-expanded="false"
                  >
                    {faq.topic}
                    <svg class="store-faq-icon w-4 h-4 text-on-surface-variant group-hover:text-primary transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6" />
                    </svg>
                  </button>
                  <div class="store-faq-content hidden mt-1 text-on-surface-variant text-sm leading-relaxed">
                    {faq.content}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Newsletter CTA -->
        <div class="bg-midnight-navy p-6 rounded-xl text-white">
          <h3 class="text-xl font-bold mb-2">Never Miss a Deal</h3>
          <p class="text-slate-gray text-sm mb-4">Get exclusive voucher codes for {store.name} directly to your inbox.</p>
          <form class="space-y-3" on:submit|preventDefault>
            <input
              type="email"
              placeholder="Enter email address"
              class="w-full bg-white/10 border border-white/20 rounded-lg py-3 px-4 text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <button type="submit" class="w-full bg-primary text-white label-caps py-3 rounded-lg hover:bg-primary-hover transition-colors">
              SUBSCRIBE
            </button>
          </form>
        </div>
      </aside>
    </div>

    <!-- Related Stores -->
    {relatedStores.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold text-on-surface mb-6">Related Stores</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {relatedStores.map((relatedStore) => (
            <StoreCard store={relatedStore} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  // Store page FAQ accordion
  document.querySelectorAll('.store-faq-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement;
      const icon = button.querySelector('.store-faq-icon') as SVGElement;
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      
      button.setAttribute('aria-expanded', String(!isExpanded));
      content?.classList.toggle('hidden');
      
      if (icon) {
        if (!isExpanded) {
          icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6" />';
        } else {
          icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6" />';
        }
      }
    });
  });
</script>
