---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import HeroStats from '../components/HeroStats.astro';
import FeaturedBrands from '../components/FeaturedBrands.astro';
import CouponCard from '../components/CouponCard.astro';
import StoreCard from '../components/StoreCard.astro';
import ValueProps from '../components/ValueProps.astro';
import FAQSection from '../components/FAQSection.astro';
import { getSiteStats, getLatestCoupons, getPopularStores, getPopularBrands, getTopMenus } from '../lib/cms-client';
import type { SiteStoreSummary, CouponWithSiteStore, DecorationBrand, TopMenuItem } from '../lib/types';

let stats = { storeCount: 3000, couponCount: 25000 };
let latestCoupons: CouponWithSiteStore[] = [];
let popularStores: SiteStoreSummary[] = [];
let popularBrands: DecorationBrand[] = [];
let categories: TopMenuItem[] = [];

try {
  stats = await getSiteStats();
} catch (e) {
  console.error('[Homepage] Failed to fetch site stats:', e);
}

try {
  latestCoupons = await getLatestCoupons(10);
} catch (e) {
  console.error('[Homepage] Failed to fetch latest coupons:', e);
}

try {
  popularStores = await getPopularStores(12);
} catch (e) {
  console.error('[Homepage] Failed to fetch popular stores:', e);
}

try {
  popularBrands = await getPopularBrands();
} catch (e) {
  console.error('[Homepage] Failed to fetch popular brands:', e);
}

try {
  categories = await getTopMenus();
} catch (e) {
  console.error('[Homepage] Failed to fetch categories:', e);
}
---

<BaseLayout>
  <head>
    <SEO
      title="WhatsDiscount - UK's Most Trusted Coupon Destination"
      description="Discover hand-tested discount codes and exclusive vouchers from hundreds of top UK retailers. Save more on every purchase."
      structuredData={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "WhatsDiscount",
        "url": "https://www.whatsdiscount.co.uk",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://www.whatsdiscount.co.uk/discount/{search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }}
    />
  </head>
  
  <!-- Hero Section -->
  <HeroStats storeCount={stats.storeCount} couponCount={stats.couponCount} />

  <main>

    <!-- Featured Brands -->
    {popularBrands.length > 0 && (
      <section class="px-4 sm:px-6 lg:px-8 py-8">
        <div class="max-w-container-max mx-auto">
          <FeaturedBrands brands={popularBrands} />
        </div>
      </section>
    )}

    <!-- Today's Top Coupons -->
    <section class="bg-surface-container-low py-12 md:py-16">
      <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <p class="label-caps text-primary mb-2 uppercase tracking-widest">Latest Offers</p>
          <h2 class="text-2xl md:text-3xl font-bold text-midnight-navy">
            Today's Top <span class="italic text-primary">Coupons</span>
          </h2>
          <p class="text-on-surface-variant mt-2">Hand-picked deals and voucher codes updated every hour</p>
        </div>
        
        {latestCoupons.length > 0 ? (
          <div class="space-y-4 max-w-4xl mx-auto">
            {latestCoupons.map((item) => (
              <CouponCard coupon={item} store={item.siteStore} variant="ticket" />
            ))}
          </div>
        ) : (
          <div class="text-center py-12 bg-white rounded-xl border border-outline-variant/30">
            <p class="text-on-surface-variant">No deals available at the moment. Check back soon!</p>
          </div>
        )}
        
        <div class="mt-8 text-center">
          <a href="/stores" class="inline-flex items-center gap-2 text-white bg-midnight-navy px-8 py-3 rounded-full hover:bg-primary transition-colors font-medium">
            Browse All Vouchers
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Categories -->
    {categories.length > 0 && (
      <section class="py-12 md:py-16">
        <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-10">
            <p class="label-caps text-primary mb-2 uppercase tracking-widest">Explore</p>
            <h2 class="text-2xl md:text-3xl font-bold text-midnight-navy">
              Browse by <span class="italic text-primary">Category</span>
            </h2>
          </div>
          <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
            {categories.map((cat) => (
              <a href={cat.path} class="tag">{cat.name}</a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Popular Stores -->
    {popularStores.length > 0 && (
      <section class="py-12 md:py-16">
        <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-10">
            <p class="label-caps text-primary mb-2 uppercase tracking-widest">Popular</p>
            <h2 class="text-2xl md:text-3xl font-bold text-midnight-navy">
              Popular <span class="italic text-primary">Stores</span>
            </h2>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            {popularStores.map((store) => (
              <StoreCard store={store} />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Why WhatsDiscount? -->
    <ValueProps />

    <!-- FAQ Section -->
    <FAQSection />

    <!-- Newsletter -->
    <section class="bg-midnight-navy py-16 md:py-20 overflow-hidden relative">
      <div class="absolute right-0 top-0 opacity-[0.05] pointer-events-none">
        <span class="text-[400px] md:text-[600px] font-extrabold text-white select-none leading-none">%</span>
      </div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white mb-4 tracking-tight">
          Never Miss a <span class="italic text-primary">Deal</span>
        </h2>
        <p class="text-slate-gray text-lg mb-8">Join over 50,000 savvy UK shoppers who receive our weekly digest of exclusive discount codes.</p>
        <form class="flex flex-col md:flex-row gap-3 max-w-2xl mx-auto" on:submit|preventDefault>
          <input
            type="email"
            placeholder="Enter your email address"
            class="flex-grow bg-white/10 border border-white/20 rounded-xl px-6 py-4 text-white placeholder:text-white/40 focus:ring-2 focus:ring-primary outline-none transition-all"
          />
          <button type="submit" class="bg-white text-midnight-navy font-bold px-8 py-4 rounded-xl hover:bg-primary hover:text-white transition-all whitespace-nowrap">
            Get Weekly Deals
          </button>
        </form>
        <div class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 text-white/40 label-caps text-xs">
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            NO SPAM
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            UNSUBSCRIBE ANYTIME
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            FREE FOREVER
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
