---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title="Terms of Use - WhatsDiscount | Terms & Conditions"
      description="Read the WhatsDiscount Terms of Use to understand the rules, conditions, and guidelines for using our voucher code website and services."
      structuredData={{
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Terms of Use",
        "description": "WhatsDiscount Terms of Use - Rules and conditions for using our voucher code website.",
        "url": "https://www.whatsdiscount.co.uk/terms",
        "datePublished": "2026-01-01",
        "dateModified": "2026-01-01",
        "publisher": {
          "@type": "Organization",
          "name": "WhatsDiscount",
          "url": "https://www.whatsdiscount.co.uk"
        }
      }}
    />
  </Fragment>

  <!-- Hero Section -->
  <section class="bg-midnight-navy py-16 md:py-20">
    <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8">
      <p class="label-caps text-primary uppercase tracking-widest mb-4">Legal</p>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4 tracking-tight">
        Terms of <span class="italic text-primary">Use</span>
      </h1>
      <p class="text-slate-gray text-lg max-w-2xl">
        Please read these terms carefully before using our website.
      </p>
      <p class="text-white/50 text-sm mt-4">Last updated: January 2026</p>
    </div>
  </section>

  <!-- Quick Summary -->
  <section class="py-8 md:py-12 border-b border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card p-5 flex items-start gap-3">
          <div class="w-10 h-10 bg-surface-container-low rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <p class="text-on-surface-variant text-sm leading-relaxed">We provide voucher codes from third parties — always verify before purchase</p>
          </div>
        </div>
        <div class="card p-5 flex items-start gap-3">
          <div class="w-10 h-10 bg-surface-container-low rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div>
            <p class="text-on-surface-variant text-sm leading-relaxed">We protect your privacy and won't share your email with third parties</p>
          </div>
        </div>
        <div class="card p-5 flex items-start gap-3">
          <div class="w-10 h-10 bg-surface-container-low rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <p class="text-on-surface-variant text-sm leading-relaxed">All content is copyrighted — no reproduction without permission</p>
          </div>
        </div>
        <div class="card p-5 flex items-start gap-3">
          <div class="w-10 h-10 bg-surface-container-low rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <div>
            <p class="text-on-surface-variant text-sm leading-relaxed">Terms may be updated — please check regularly</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 space-y-12">

    <!-- Copyright -->
    <section id="copyright">
      <h2 class="text-2xl font-bold text-midnight-navy mb-6">Copyright</h2>
      <p class="text-on-surface-variant leading-relaxed mb-6">
        The copyright of the materials contained in this website and all other intellectual property rights, as well as the website design, images and source code, belong to us and all rights reserved.
      </p>

      <div class="bg-error/10 border border-error/20 rounded-lg p-5 flex items-start gap-3">
        <svg class="w-5 h-5 text-error mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <h3 class="font-semibold text-midnight-navy text-sm mb-1">Important Notice</h3>
          <p class="text-on-surface-variant text-sm leading-relaxed">
            whatsdiscount.co.uk does not permit reproduction, transmission, or storage of content on any other website. This prohibition applies to unauthorized uses or reproduction for public or private use.
          </p>
        </div>
      </div>
    </section>

    <!-- The Service -->
    <section id="the-service">
      <h2 class="text-2xl font-bold text-midnight-navy mb-6">The Service</h2>
      <p class="text-on-surface-variant leading-relaxed mb-6">
        whatsdiscount.co.uk provide online voucher codes to our users only. The voucher codes are provided by a third party, so we do not guarantee that the code is valid.
      </p>

      <div class="card p-6 mb-6">
        <h3 class="font-semibold text-midnight-navy mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Tips for Using Voucher Codes
        </h3>
        <ul class="space-y-3 text-on-surface-variant text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-primary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Always check that any applicable discounts have been applied before making any purchases
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-primary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Verify the terms and conditions of each voucher code
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-primary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            If any discount questions arise, please contact the retailer directly or check their policy
          </li>
        </ul>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card p-5 text-center">
          <div class="w-12 h-12 bg-surface-container-low rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
          </div>
          <h3 class="font-semibold text-midnight-navy text-sm mb-1">Voucher Codes</h3>
          <p class="text-on-surface-variant text-xs">Access thousands of discount codes from popular retailers</p>
        </div>
        <div class="card p-5 text-center">
          <div class="w-12 h-12 bg-surface-container-low rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <h3 class="font-semibold text-midnight-navy text-sm mb-1">Deals & Offers</h3>
          <p class="text-on-surface-variant text-xs">Find the best deals and special promotions</p>
        </div>
        <div class="card p-5 text-center">
          <div class="w-12 h-12 bg-surface-container-low rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="font-semibold text-midnight-navy text-sm mb-1">Regular Updates</h3>
          <p class="text-on-surface-variant text-xs">Codes are updated daily for accuracy</p>
        </div>
      </div>
    </section>

    <!-- Data Protection and Privacy -->
    <section id="data-protection">
      <h2 class="text-2xl font-bold text-midnight-navy mb-6">Data Protection and Privacy Policy</h2>
      <p class="text-on-surface-variant leading-relaxed mb-6">
        We encourage you to subscribe to our services by email and we will send you quality vouchers and discount offers on a regular basis.
      </p>

      <div class="card p-6 mb-6 flex items-start gap-4">
        <div class="w-10 h-10 bg-success/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-midnight-navy mb-1">Our Privacy Commitment</h3>
          <p class="text-on-surface-variant text-sm leading-relaxed">
            We won't share your mail or sell it to any third party.
          </p>
        </div>
      </div>

      <p class="text-on-surface-variant leading-relaxed">
        We reserve the right to collect, transfer, process information relating to the use of the Site and obtained directly or indirectly from information collected by us in order to web traffic analysis and trends, in accordance with our <a href="/privacy" class="text-primary hover:text-primary-hover">Privacy Policy</a>.
      </p>
    </section>

    <!-- Disclosure -->
    <section id="disclosure">
      <h2 class="text-2xl font-bold text-midnight-navy mb-6">Disclosure</h2>

      <div class="card p-6 mb-6 flex items-start gap-4">
        <div class="w-10 h-10 bg-surface-container-low rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-midnight-navy mb-1">Our Goal</h3>
          <p class="text-on-surface-variant text-sm leading-relaxed">
            Helping save time and money for your online shopping!
          </p>
        </div>
      </div>

      <p class="text-on-surface-variant leading-relaxed mb-6">
        These rules and the Code of Conduct can be changed or updated at any time, please check them regularly.
      </p>

      <div class="card p-6 mb-6 flex items-start gap-4">
        <div class="w-10 h-10 bg-surface-container-low rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-midnight-navy mb-1">Agreement</h3>
          <p class="text-on-surface-variant text-sm leading-relaxed">
            By continuing to use WhatsDiscount you agree to follow the code of conduct implicitly.
          </p>
        </div>
      </div>

      <div class="bg-surface-container-low rounded-lg p-6">
        <h3 class="font-semibold text-midnight-navy mb-3">By Using Our Website</h3>
        <p class="text-on-surface-variant text-sm leading-relaxed">
          You acknowledge that you have read, understood, and agree to be bound by these Terms of Use and our Privacy Policy.
        </p>
        <div class="flex flex-wrap gap-4 mt-4">
          <a href="/privacy" class="text-primary font-semibold hover:text-primary-hover transition-colors">
            Privacy Policy →
          </a>
          <a href="/contact" class="text-primary font-semibold hover:text-primary-hover transition-colors">
            Contact Us →
          </a>
        </div>
      </div>
    </section>

  </div>

  <!-- Consent Notice -->
  <section class="bg-surface-container py-8">
    <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-on-surface-variant text-sm font-semibold uppercase tracking-wider">
        Use of this site signifies your consent to these Terms of Use and our Privacy Policy.
      </p>
    </div>
  </section>
</BaseLayout>
