---
import { getStoreDetail } from '../../lib/cms-client';
import { getImageUrl, decodeCouponLink, encodeCouponLink } from '../../lib/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import type { SiteStoreDetail, Coupon } from '../../lib/types';

const { pid } = Astro.params;

if (!pid) {
  return Astro.redirect('/');
}

let domain: string;
let couponId: number;

try {
  const decoded = decodeCouponLink(pid);
  domain = decoded.domain;
  couponId = decoded.couponId;
} catch {
  return Astro.redirect('/');
}

let store: SiteStoreDetail | null = null;
let coupon: Coupon | null = null;

try {
  store = await getStoreDetail(domain);
  coupon = store.coupons.find((c) => c.id === couponId) || null;
} catch {
  return Astro.redirect('/');
}

if (!coupon) {
  return Astro.redirect(`/discount/${domain}`);
}

const isValid = coupon.isValid !== 0;
const encodedId = encodeCouponLink(store.domain, coupon.id);
const discountText = coupon.disInfo || coupon.title;

function formatUses(n?: number): string {
  if (!n) return '0';
  return n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : `${n}`;
}
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title={`${coupon.title} - ${store.name} | WhatsDiscount`}
      description={coupon.description || coupon.title}
      image={getImageUrl(store.logoPic)}
      structuredData={{
        "@context": "https://schema.org",
        "@type": "Offer",
        "name": coupon.title,
        "description": coupon.description || coupon.title,
        "url": `https://www.whatsdiscount.co.uk/detail/${encodedId}`,
        "seller": {
          "@type": "Organization",
          "name": store.name
        },
        "availability": isValid ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
      }}
    />
  </Fragment>

  <div class="mt-28 px-4 sm:px-6 lg:px-8 max-w-container-max mx-auto w-full pb-16">
    <a href={`/discount/${domain}`} class="inline-flex items-center text-sm text-on-surface-variant hover:text-primary transition-colors mb-6">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      View all {store.name} vouchers
    </a>
    <!-- Voucher Detail Section (The Digital Ticket) -->
    <div class="mb-gutter">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <!-- Main Ticket Column -->
        <div class="lg:col-span-8">
          <div class="glass-panel rounded-xl overflow-hidden relative border border-outline-variant/20 digital-ticket">
            <div class="p-8 md:p-12">
              <div class="flex flex-col md:flex-row gap-8 items-start">
                <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-white shadow-md flex items-center justify-center p-4 border border-outline-variant/10 shrink-0">
                  <img
                    src={getImageUrl(store.logoPic)}
                    alt={store.name}
                    class="w-full h-auto object-contain"
                  />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    {isValid && (
                      <span class="badge-verified">VERIFIED</span>
                    )}
                    <span class="label-caps text-on-surface-variant">
                      {store.lastUpdateAt ? `Updated ${new Date(store.lastUpdateAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}` : ''}
                    </span>
                  </div>
                  <h1 class="text-2xl md:text-3xl font-bold text-on-surface mb-4">{coupon.title}</h1>
                  {coupon.description && (
                    <p class="text-on-surface-variant mb-8 max-w-2xl">{coupon.description}</p>
                  )}
                  
                  <!-- Code Display Box -->
                  {coupon.type === 'code' && coupon.code && (
                    <div class="flex flex-col sm:flex-row gap-3">
                      <div class="flex items-center gap-3 bg-surface-container border-2 border-dashed border-primary rounded-xl px-6 py-4 flex-1">
                        <code class="text-xl font-mono font-bold text-primary tracking-wider flex-1 break-all">{coupon.code}</code>
                        <button
                          id="copy-btn"
                          data-code={coupon.code}
                          class="btn-primary px-6 py-2 whitespace-nowrap"
                        >
                          Copy
                        </button>
                      </div>
                      <div class="flex items-center gap-2 label-caps border border-outline-variant/30 rounded-xl px-4 h-14">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        {coupon.expireDate
                          ? `Expires ${new Date(coupon.expireDate).toLocaleDateString('en-GB')}`
                          : store.lastUpdateAt
                            ? `Expires ${new Date(store.lastUpdateAt).toLocaleDateString('en-GB')}`
                            : null}
                      </div>
                    </div>
                  )}
                  
                  {! (coupon.type === 'code' && coupon.code) && (
                    <div class="flex flex-col sm:flex-row gap-3">
                      <a
                        href={`/api/r?domain=${store.domain}`}
                        class="btn-primary px-8 flex items-center gap-2"
                        rel="nofollow noopener"
                        target="_blank"
                      >
                        Reveal Deal
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
            
            {coupon.usesToday && coupon.successRate && coupon.avgSaving && (
              <>
                <!-- Ticket Dotted Divider -->
                <div class="relative h-4 w-full flex items-center px-4 overflow-hidden">
                  <div class="w-full border-t-2 border-dashed border-outline-variant/30"></div>
                </div>
                
                <!-- Stats Footer -->
                <div class="bg-surface-container-low/50 p-6 flex flex-wrap gap-8 justify-around">
                  <div class="text-center">
                    <div class="text-primary text-2xl font-bold">{formatUses(coupon.usesToday)}</div>
                    <div class="label-caps text-on-surface-variant">Uses Today</div>
                  </div>
                  <div class="text-center">
                    <div class="text-primary text-2xl font-bold">{coupon.successRate}%</div>
                    <div class="label-caps text-on-surface-variant">Success Rate</div>
                  </div>
                  <div class="text-center">
                    <div class="text-primary text-2xl font-bold">£{coupon.avgSaving}</div>
                    <div class="label-caps text-on-surface-variant">Avg. Saving</div>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>
        
        <!-- How to use Sidebar -->
        <div class="lg:col-span-4">
          <div class="glass-panel p-8 rounded-xl h-full border border-outline-variant/20">
            <h3 class="text-xl font-bold text-on-surface mb-6">How to use</h3>
            <ul class="space-y-6">
              <li class="flex gap-4">
                <span class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold shrink-0">1</span>
                <p class="text-on-surface-variant">Click the <strong>Copy</strong> button to copy the code to your clipboard.</p>
              </li>
              <li class="flex gap-4">
                <span class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold shrink-0">2</span>
                <p class="text-on-surface-variant">Paste the code into the 'Promo Code' box at checkout to apply your discount.</p>
              </li>
            </ul>
            <div class="mt-10 p-4 rounded-lg bg-surface-container border border-outline-variant/30">
              <div class="flex items-center gap-2 text-primary mb-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="font-bold text-sm">Pro Tip</span>
              </div>
              <p class="text-on-surface-variant text-sm">Check if the item is already on sale. Some codes stack for even bigger savings!</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-btn');
  
  copyBtn?.addEventListener('click', async () => {
    const code = copyBtn.getAttribute('data-code');
    if (!code) return;
    
    try {
      await navigator.clipboard.writeText(code);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
      }, 2000);
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = code;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
      }, 2000);
    }
  });
</script>
