---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDrawer from '../components/SearchDrawer';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "WhatsDiscount",
      "url": "https://www.whatsdiscount.co.uk",
      "logo": "https://www.whatsdiscount.co.uk/logo.png",
      "sameAs": [],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "url": "https://www.whatsdiscount.co.uk/contact"
      }
    })} />
    <slot name="head" />
  </head>
  <body>
    <div class="min-h-screen flex flex-col relative overflow-x-hidden">
      <div class="grain-overlay fixed inset-0 z-[100]"></div>
      <Header />
      
      <main class="flex-1">
        <slot />
      </main>
      
      <Footer />
    </div>

    <script is:inline set:html={`window.__IMG_URL__ = ${JSON.stringify(import.meta.env.IMG_URL || "")};`} />
    <SearchDrawer client:only="react" />
  </body>
</html>
