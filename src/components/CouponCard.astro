---
import { getImageUrl, encodeCouponLink } from '../lib/utils';
import type { Coupon, SiteStoreSummary } from '../lib/types';

interface Props {
  coupon: Coupon;
  store: SiteStoreSummary;
}

const { coupon, store } = Astro.props;
---

<div class="card p-4 md:p-6">
  <div class="flex flex-col sm:flex-row gap-4">
    <!-- Store Logo -->
    <div class="flex-shrink-0">
      <a href={`/discount/${store.domain}`} class="block w-16 h-16 md:w-20 md:h-20 rounded-lg bg-gray-100 flex items-center justify-center overflow-hidden hover:shadow-md transition-shadow">
        <img
          src={getImageUrl(store.logoPic)}
          alt={store.name}
          class="w-12 h-12 md:w-16 md:h-16 object-contain"
          loading="lazy"
        />
      </a>
    </div>

    <!-- Coupon Info -->
    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <a href={`/discount/${store.domain}`} class="text-sm font-medium text-gray-500 hover:text-primary transition-colors">
            {store.name}
          </a>
          <h3 class="text-base md:text-lg font-semibold text-gray-900 mt-1 line-clamp-2">
            {coupon.title}
          </h3>
          {coupon.description && (
            <p class="text-sm text-gray-500 mt-1 line-clamp-2">{coupon.description}</p>
          )}
        </div>
        
        {coupon.isValid !== 0 && (
          <span class="badge-verified flex-shrink-0">Verified</span>
        )}
      </div>

      {coupon.disInfo && (
        <p class="mt-3 text-sm font-semibold text-success">{coupon.disInfo}</p>
      )}

      <div class="mt-3 flex flex-wrap items-center gap-3">
        {coupon.type === 'code' && coupon.code ? (
          <a
            href={`/detail/${encodeCouponLink(store.domain, coupon.id)}`}
            class="btn-primary text-sm px-4 py-2"
          >
            Show Code
          </a>
        ) : (
          <a
            href={`/api/r?domain=${store.domain}`}
            class="btn-primary text-sm px-4 py-2"
            rel="nofollow noopener"
            target="_blank"
          >
            Get Deal
          </a>
        )}
        
        <a
          href={`/api/r?domain=${store.domain}`}
          class="text-sm text-gray-500 hover:text-primary transition-colors"
          rel="nofollow noopener"
          target="_blank"
        >
          Go to Store &rarr;
        </a>
      </div>
    </div>
  </div>
</div>
