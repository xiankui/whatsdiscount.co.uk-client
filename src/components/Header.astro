---
import { getTags } from '../lib/cms-client';

let tags: string[] = [];
try {
  tags = await getTags();
} catch {
  tags = [];
}
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 flex items-center gap-2">
        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
        <span class="text-xl font-bold text-gray-900">WhatsDiscount</span>
      </a>

      <!-- Tags Navigation (Desktop) -->
      <nav class="hidden lg:flex items-center space-x-1 flex-1 mx-6 overflow-x-auto">
        {tags.map((tag) => (
          <a
            href={`/tag-${tag.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and')}`}
            class="btn-ghost whitespace-nowrap text-sm"
          >
            {tag}
          </a>
        ))}
      </nav>

      <!-- Search & Mobile Menu -->
      <div class="flex items-center gap-3">
        <!-- Search Button -->
        <button
          id="search-trigger"
          class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors"
          aria-label="Search stores"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-trigger"
          class="lg:hidden p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Tags Navigation -->
    <nav class="lg:hidden py-3 -mx-4 px-4 overflow-x-auto flex space-x-2 border-t border-gray-100">
      {tags.map((tag) => (
        <a
          href={`/tag-${tag.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and')}`}
          class="tag whitespace-nowrap text-sm"
        >
          {tag}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  document.getElementById('search-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });
</script>
