---
import { getTopMenus } from '../lib/cms-client';
import type { TopMenuItem } from '../lib/types';

let menuItems: TopMenuItem[] = [];
try {
  menuItems = await getTopMenus();
} catch {
  menuItems = [];
}
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-white/10 shadow-sm">
  <nav class="flex justify-between items-center h-20 px-4 sm:px-6 lg:px-8 max-w-container-max mx-auto">
    <a href="/" class="text-2xl font-extrabold text-primary tracking-tighter">
      WhatsDiscount
    </a>
    
    <div class="hidden md:flex items-center gap-6">
      {menuItems.map((item) => (
        <a
          href={item.path}
          class="text-base text-on-surface-variant hover:text-primary transition-colors font-medium"
        >
          {item.name}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <button
        id="search-trigger"
        class="p-2 rounded-full hover:bg-surface-container transition-colors"
        aria-label="Search stores"
      >
        <svg class="w-5 h-5 text-midnight-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.getElementById('search-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });
</script>
