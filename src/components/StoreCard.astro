---
import { getImageUrl } from '../lib/utils';
import type { SiteStoreSummary } from '../lib/types';

interface Props {
  store: SiteStoreSummary;
}

const { store } = Astro.props;
---

<a href={`/discount/${store.domain}`} class="bg-white/50 p-4 rounded-2xl border border-outline-variant/30 hover:shadow-md transition-all group flex flex-col items-center text-center gap-3">
  <div class="w-16 h-16 rounded-full bg-white flex items-center justify-center shadow-sm border border-outline-variant/20 overflow-hidden">
    <img
      src={getImageUrl(store.logoPic)}
      alt={store.name}
      class="w-10 h-10 object-contain"
      loading="lazy"
    />
  </div>
  
  <span class="font-bold text-midnight-navy group-hover:text-primary transition-colors">
    {store.name}
  </span>
  
  {store.couponCount && (
    <span class="label-caps text-primary">{store.couponCount} ACTIVE VOUCHERS</span>
  )}
</a>
