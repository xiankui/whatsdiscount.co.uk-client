---
import type { CouponWithSiteStore } from '../lib/types';

interface Props {
  coupons: CouponWithSiteStore[];
}

const { coupons } = Astro.props;
---

<div class="overflow-x-auto flex gap-3 pb-2 scrollbar-hide">
  {coupons.slice(0, 6).map((coupon) => (
    <a
      href={coupon.type === 'code' && coupon.code ? `/detail/${btoa(`${coupon.siteStore.domain}&${coupon.id}`)}` : `/api/r?domain=${coupon.siteStore.domain}`}
      class="flex items-center gap-2 px-5 py-2 rounded-full border border-outline-variant/30 bg-white shadow-sm hover:border-primary hover:shadow-md transition-all whitespace-nowrap"
    >
      {coupon.type === 'code' && coupon.code ? (
        <>
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          <span class="label-caps text-midnight-navy">{coupon.code}</span>
        </>
      ) : (
        <>
          <svg class="w-4 h-4 text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
          </svg>
          <span class="label-caps text-midnight-navy">{coupon.disInfo || 'DEAL'}</span>
        </>
      )}
    </a>
  ))}
</div>
