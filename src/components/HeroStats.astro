---
interface Props {
  storeCount: number;
  couponCount: number;
}

const { storeCount, couponCount } = Astro.props;
---

<section class="bg-gradient-to-b from-blue-50 to-white py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
        Save Money with Verified UK Voucher Codes
      </h1>
      <p class="text-lg md:text-xl text-gray-600 mb-8">
        Hand-tested codes from <span class="font-semibold text-gray-900">{storeCount.toLocaleString()}+</span> stores, updated daily
      </p>
      
      <div class="flex items-center justify-center gap-6 md:gap-12">
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-primary">{storeCount.toLocaleString()}+</div>
          <div class="text-sm text-gray-500 mt-1">Stores</div>
        </div>
        <div class="w-px h-12 bg-gray-200"></div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-primary">{couponCount.toLocaleString()}+</div>
          <div class="text-sm text-gray-500 mt-1">Active Codes</div>
        </div>
      </div>
    </div>
  </div>
</section>
