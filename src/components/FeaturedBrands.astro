---
import { getImageUrl } from '../lib/utils';
import type { DecorationBrand } from '../lib/types';

interface Props {
  brands: DecorationBrand[];
}

const { brands } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
  {brands.slice(0, 3).map((brand) => (
    <a
      href={`/discount/${brand.domain}`}
      class="group relative overflow-hidden rounded-xl h-72 shadow-md hover:shadow-xl transition-shadow"
    >
      <img
        src={brand.pic}
        alt={brand.name}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-midnight-navy/80 to-transparent"></div>
      <div class="absolute bottom-6 left-6 text-white">
        <div class="bg-white p-2 rounded mb-3 inline-block">
          <img
            src={getImageUrl(brand.logo)}
            alt={brand.name}
            class="h-7 object-contain"
          />
        </div>
        <h3 class="text-xl font-bold text-white">{brand.name}</h3>
      </div>
    </a>
  ))}
</div>
