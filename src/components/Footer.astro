---
const currentYear = new Date().getFullYear();
---

<footer class="bg-midnight-navy w-full mt-auto border-t border-white/10">
  <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter text-white">
      <div>
        <img src="/logo.svg" alt="WhatsDiscount" class="h-8 w-auto mb-4" />
        <p class="text-slate-gray text-sm leading-relaxed">
          Your trusted source for the best deals and discount codes in the UK. Helping millions save every day.
        </p>
      </div>
      <div class="flex flex-col gap-2">
        <p class="label-caps text-white/60 mb-2 uppercase">Quick Links</p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/about" class="text-slate-gray hover:text-white transition-colors text-sm hover:underline decoration-primary">About</a>
          <a href="/privacy" class="text-slate-gray hover:text-white transition-colors text-sm hover:underline decoration-primary">Privacy</a>
          <a href="/terms" class="text-slate-gray hover:text-white transition-colors text-sm hover:underline decoration-primary">Terms</a>
          <a href="/imprint" class="text-slate-gray hover:text-white transition-colors text-sm hover:underline decoration-primary">Imprint</a>
          <a href="/contact" class="text-slate-gray hover:text-white transition-colors text-sm hover:underline decoration-primary">Contact</a>
        </div>
      </div>
      <div class="flex flex-col md:items-end">
        <p class="label-caps text-white/60 mb-4 uppercase">Share</p>
        <div class="flex gap-3">
          <button id="share-x" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary transition-colors cursor-pointer" aria-label="Share on X">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </button>
          <button id="share-facebook" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary transition-colors cursor-pointer" aria-label="Share on Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </button>
        </div>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-white/40 text-xs label-caps">
      <p>© {currentYear} whatsdiscount.co.uk. All rights reserved. Registered in England & Wales.</p>
      <p>Made with <span class="text-primary">♥</span> for UK shoppers</p>
    </div>
  </div>
</footer>

<script>
  const shareUrl = encodeURIComponent(window.location.href);
  const shareTitle = encodeURIComponent(document.title);

  document.getElementById('share-x')?.addEventListener('click', () => {
    window.open(`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`, '_blank', 'noopener,noreferrer');
  });

  document.getElementById('share-facebook')?.addEventListener('click', () => {
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, '_blank', 'noopener,noreferrer');
  });
</script>
