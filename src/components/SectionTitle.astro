---
interface Props {
  title: string;
  href?: string;
  linkText?: string;
}

const { title, href, linkText = 'View all' } = Astro.props;
---

<div class="flex items-center justify-between mb-6">
  <h2 class="text-2xl md:text-3xl font-bold text-gray-900">{title}</h2>
  {href && (
    <a href={href} class="text-sm font-medium text-primary hover:text-primary-hover">
      {linkText} &rarr;
    </a>
  )}
</div>
